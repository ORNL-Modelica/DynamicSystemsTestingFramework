{
  "tests": [
    {
      "model": "ModelicaTestingLib.Examples.NoUnitTest",
      "variables": [
        "x"
      ],
      "simulation": {
        "stop_time": 5,
        "tolerance": 0.0001
      }
    },
    {
      "model": "ModelicaTestingLib.Examples.TubeToleranceTest",
      "comparison": {
        "variable_overrides": {
          "unitTests.x[1]": {
            "mode": "tube",
            "tube_width_mode": "rel",
            "tube_rel": 0.05
          }
        }
      }
    },
    {
      "model": "ModelicaTestingLib.Examples.FrequencyTest",
      "comparison": {
        "variable_overrides": {
          "unitTests.x[1]": {
            "mode": "dominant-frequency",
            "peaks": [
              {
                "freq": 1.0,
                "tolerance": 0.15,
                "tolerance_mode": "rel"
              }
            ]
          }
        }
      }
    },
    {
      "model": "ModelicaTestingLib.Examples.MultiFrequencyTest",
      "comparison": {
        "variable_overrides": {
          "unitTests.x[1]": {
            "mode": "dominant-frequency",
            "peaks": [
              {
                "freq": 1.0,
                "tolerance": 0.15,
                "tolerance_mode": "rel"
              },
              {
                "freq": 3.0,
                "tolerance": 0.1,
                "tolerance_mode": "rel"
              },
              {
                "freq": 7.0,
                "tolerance": 0.05,
                "tolerance_mode": "rel"
              }
            ]
          }
        }
      }
    },
    {
      "model": "ModelicaTestingLib.Examples.MetricTreeTest",
      "metrics": {
        "combinator": "and",
        "children": [
          {
            "metric": "nrmse",
            "variable": "unitTests.x[1]",
            "tolerance": 0.001,
            "window": {
              "end": 2.5
            }
          },
          {
            "metric": "tube",
            "variable": "unitTests.x[1]",
            "tube_width_mode": "rel",
            "tube_rel": 0.02,
            "tube_min_width": 0.005,
            "window": {
              "start": 2.5
            }
          },
          {
            "combinator": "warn",
            "children": [
              {
                "metric": "nrmse",
                "variable": "unitTests.x[1]",
                "against": "openmodelica",
                "tolerance": 0.01
              }
            ]
          },
          {
            "metric": "range",
            "variable": "unitTests.x[2]",
            "max_value": 1.0
          }
        ]
      }
    },
    {
      "model": "ModelicaTestingLib.Examples.EventTest",
      "metrics": {
        "combinator": "and",
        "children": [
          {
            "metric": "nrmse",
            "variable": "unitTests.x[1]",
            "tolerance": 0.001
          },
          {
            "metric": "event-timing",
            "variable": "unitTests.x[2]",
            "time_tolerance": 0.01
          }
        ]
      }
    },
    {
      "model": "ModelicaTestingLib.Examples.SimpleTest",
      "metrics": {
        "combinator": "and",
        "children": [
          {
            "combinator": "k-of-n",
            "k": 1,
            "children": [
              {
                "metric": "nrmse",
                "variable": "unitTests.x[1]",
                "tolerance": 0.0001
              },
              {
                "metric": "nrmse",
                "variable": "unitTests.x[2]",
                "tolerance": 0.0001
              }
            ]
          },
          {
            "metric": "scalar",
            "variable": "unitTests.x[1]",
            "quantity": {
              "reduce": "final"
            },
            "tolerance": 0.001,
            "tolerance_mode": "abs"
          }
        ]
      }
    },
    {
      "model": "ModelicaTestingLib.Examples.ConstantTest",
      "metrics": {
        "combinator": "weighted",
        "weights": [
          0.5,
          0.5
        ],
        "threshold": 0.0001,
        "direction": "less",
        "children": [
          {
            "metric": "nrmse",
            "variable": "unitTests.x[1]",
            "tolerance": 0.0001
          },
          {
            "metric": "nrmse",
            "variable": "unitTests.x[2]",
            "tolerance": 0.0001
          }
        ]
      }
    },
    {
      "model": "ModelicaTestingLib.Examples.IntervalTest",
      "metrics": {
