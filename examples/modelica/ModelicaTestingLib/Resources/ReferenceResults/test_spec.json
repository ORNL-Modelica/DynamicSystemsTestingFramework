    {
      "model": "ModelicaTestingLib.Examples.RangeCheckTest",
      "comparison": {
        "variable_overrides": {
          "unitTests.x[1]": {
            "mode": "range",
            "min_value": -1.05,
            "max_value": 1.05
          }
