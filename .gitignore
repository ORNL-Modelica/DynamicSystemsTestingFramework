# Python
__pycache__/
*.py[codz]
*.egg-info/
dist/
build/
*.egg

# Virtual environments (.venv-example/: the one docs/guides/first-run.md makes)
.venv/
.venv-example/
venv/
.env

# uv
# uv.lock is committed for reproducibility

# Dymola artifacts
*.mat
dslog.txt
dsin.txt
dsfinal.txt
buildlog.txt
dymosim
dymosim.exe
dymosim.exp
dymosim.lib
dymosim.dll
dsmodel.c
dsmodel_att.h
dymola.log
status
success
failure
*.bif-*

# Keep test fixture results (override above exclusions)
!tests/fixtures/results/**/*.mat
!tests/fixtures/**/dslog.txt
!tests/fixtures/results/**/dsin.txt
!tests/fixtures/results/**/dsfinal.txt
!tests/fixtures/results_openmodelica/**/*.mat

# Simulation output (generated by the tool)
testing_output/

# Generated reports (dashboard.html, interactive plots, comparison_data.json)
reports/

# The documentation site, built (sphinx-build docs docs/_build/html)
docs/_build/

# Reference-FMUs binaries (fetched by scripts/fetch_reference_fmus.py)
examples/fmu/reference-fmus-binaries/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Coverage / testing
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.tox/
.nox/

# Translations (gettext .mo — NOT Modelica .mo files)
*.pot

# Cursor
.cursorignore
.cursorindexingignore
# Local agent configuration and working notes. Machine-local: the paths
# inside resolve only on the machine that wrote them.
.claude/

# Local working-session notes and agent state — never published.
# The project's durable record is docs/decisions.md.
.soul/
